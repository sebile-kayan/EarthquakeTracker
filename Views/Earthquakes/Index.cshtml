@model EarthquakeListViewModel
@{
    ViewData["Title"] = "Depremler";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Depremler</h2>
        <small class="text-muted">
            Otomatik yenileniyor · Son yenileme: @DateTime.UtcNow.ToTurkeyTime().ToString("HH:mm:ss")
        </small>
    </div>
    <form asp-action="Sync" method="post">
        <button type="submit" class="btn btn-primary">Şimdi Güncelle</button>
    </form>
</div>

<!-- Filtre formu -->
<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="number" step="0.1" min="0" name="minMagnitude"
               value="@Model.MinMagnitude" class="form-control" placeholder="En az büyüklük" />
    </div>
    <div class="col-auto">
        <input type="text" name="place" value="@Model.Place"
               class="form-control" placeholder="Yer (örn. Feke)" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Filtrele</button>
        <a asp-action="Index" class="btn btn-link">Temizle</a>
    </div>
</form>

<p class="text-muted">Toplam @Model.Result.TotalCount kayıt</p>

<table class="table table-sm table-hover">
    <thead>
        <tr>
            <th>Zaman (TR)</th>
            <th>Yer</th>
            <th class="text-end">Büyüklük</th>
            <th class="text-end">Derinlik (km)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var earthquake in Model.Result.Items)
        {
            <tr class="@(earthquake.Magnitude >= AlertSettings.Value.MinMagnitude ? "table-danger" : "")">
                <td>@earthquake.OccurredAtUtc.ToTurkeyTime().ToString("dd.MM.yyyy HH:mm")</td>
                <td>@earthquake.Place</td>
                <td class="text-end">@earthquake.Magnitude.ToString("0.0")</td>
                <td class="text-end">@earthquake.DepthKm.ToString("0.0")</td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@earthquake.Id" class="btn btn-sm btn-outline-primary">Detay</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<partial name="_Pagination" model="Model.Result" />

@section Scripts {
    <script>
        // Her 60 saniyede sayfayı yenile; sekme arka plandaysa yenileme
        const refreshSeconds = 60;

        setInterval(() => {
            if (document.visibilityState === "visible") {
                location.reload();
            }
        }, refreshSeconds * 1000);
    </script>
}