{
  "ConnectionStrings": {
    "Default": "Data Source=.\\MSSQLSERVER01;Database=EarthquakeDb;Integrated Security=True;Trusted_Connection=True;TrustServerCertificate=True"
  },
  // Görmek istediğimiz depremlerin büyüklüğü ve konumunu burdaki tek yerden ayarlayabiliriz. Optionslarda bunlara ait işlemleri tanımladık.
  "Usgs": {
    "BaseUrl": "https://earthquake.usgs.gov/",
    "TimeoutSeconds": 15,
    "MinMagnitude": 2.5,
    "LookbackHours": 24,
    "Region": null
  },

  "Alerts": {
    "MinMagnitude": 4.5
  },

  "Jobs": {
    "FetchEarthquakesCron": "* * * * *", //Dakikada bir recurring job için
    "CleanupCron": "0 3 * * *",
    "RetentionDays": 120
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },

  "AllowedHosts": "*"
}